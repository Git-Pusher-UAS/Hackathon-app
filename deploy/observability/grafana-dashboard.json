{
  "title": "SAI Backend Overview",
  "panels": [
    {"type":"timeseries","title":"HTTP Requests/s","targets":[{"expr":"sum(rate(sai_http_requests_total[5m])) by (status)"}]},
    {"type":"timeseries","title":"HTTP Latency p95","targets":[{"expr":"histogram_quantile(0.95, sum(rate(sai_http_request_duration_seconds_bucket[5m])) by (le, route))"}]},
    {"type":"stat","title":"Rate Limit Blocks","targets":[{"expr":"increase(sai_rate_limit_blocked_total[1h])"}]},
    {"type":"stat","title":"OTP Verify Failures","targets":[{"expr":"increase(sai_otp_verifications_total{result=\"fail\"}[1h])"}]},
    {"type":"stat","title":"Audit Append Errors","targets":[{"expr":"increase(sai_audit_append_errors_total[1h])"}]}
  ],
  "schemaVersion": 39,
  "version": 1
}
