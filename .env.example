# Copia este archivo a .env y rellena los valores. .env no se sube a git.
# Genera las claves con: openssl rand -base64 32   (JWT_SECRET: -base64 64)

# Server
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Database (Postgres de docker-compose: 5433 en el host)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sai
DB_SSLMODE=disable

# MFA (obligatoria, base64 de 32 bytes)
MFA_ENCRYPTION_KEY=

# JWT (JWT_SECRET obligatoria)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# CURP / cifrado de expedientes (sin ellas esos endpoints responden 503)
CURP_HMAC_KEY=
KEK_MASTER=
# KEK_VERSION=1

# Admin inicial (lo crea `go run ./cmd/seed`)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
